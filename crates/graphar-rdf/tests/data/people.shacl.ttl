@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix ex: <https://example.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:PersonShape a sh:NodeShape ;
  sh:targetClass ex:Person ;
  sh:property [ sh:path foaf:name ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
  sh:property [ sh:path schema:name ; sh:datatype xsd:string ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:age ; sh:datatype xsd:integer ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:born ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:active ; sh:datatype xsd:boolean ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:nick ; sh:datatype rdf:langString ] ;
  sh:property [ sh:path ex:motto ; sh:languageIn ( "en" ) ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:homepage ; sh:nodeKind sh:IRI ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:tag ; sh:datatype xsd:string ] ;
  sh:property [ sh:path ex:knows ; sh:class ex:Person ] ;
  sh:property [ sh:path ex:worksFor ; sh:node ex:OrganizationShape ; sh:maxCount 1 ] .

ex:OrganizationShape a sh:NodeShape ;
  sh:targetClass ex:Organization ;
  sh:property [ sh:path schema:name ; sh:datatype rdf:langString ; sh:maxCount 1 ] ;
  sh:property [ sh:path ex:founded ; sh:datatype xsd:int ; sh:maxCount 1 ] .
