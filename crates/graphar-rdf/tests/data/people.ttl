@prefix ex: <https://example.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:alice a ex:Person ;
  foaf:name "Alice" ; schema:name "Alice Liddell" ;
  ex:age 30 ; ex:born "1990-05-01"^^xsd:date ; ex:active true ;
  ex:nick "Al"@en, "Ali"@es ; ex:motto "Curiouser"@en ;
  ex:homepage <https://alice.example> ;
  ex:knows ex:bob, ex:carol ;
  ex:worksFor ex:acme ;
  ex:tag "a", "b" .

ex:bob a ex:Person ;
  foaf:name "Bob" ;
  ex:age "031"^^xsd:integer ;
  ex:born "1985-11-01"^^xsd:date ;
  ex:active "0"^^xsd:boolean ;
  ex:knows ex:alice .

ex:carol a ex:Person ;
  foaf:name "Carol" ;
  ex:age 25 ;
  ex:knows ex:dave ;
  ex:worksFor ex:acme .

ex:dave a ex:Person ;
  ex:age 41 .

ex:acme a ex:Organization ;
  schema:name "ACME"@en ;
  ex:founded "1999"^^xsd:int .
